# -----------------------------------------------------------------
# MYHUB ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------

# Database URL (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host/myhub?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-byte-hex-string-for-nextauth"

# Master Encryption Key (Phải đủ 64 ký tự Hex = 32 bytes dùng cho AES-256-GCM)
# Sinh ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Cấu hình Webhook SePay / Casso (Tùy chọn)
SEPAY_API_KEY=""
SEPAY_WEBHOOK_SECRET=""
CASSO_API_KEY=""
CASSO_WEBHOOK_SECRET=""

# Default User Setup (Dùng khi chạy prisma/seed.ts)
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="REDACTED_PASS"
