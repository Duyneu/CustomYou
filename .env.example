# -----------------------------------------------------------------
# MYHUB ENVIRONMENT CONFIGURATION (TEMPLATE)
# -----------------------------------------------------------------

# Database URL (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://username:password@host.aws.neon.tech/myhub?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<generate-random-32-byte-hex-string>"

# Master Encryption Key (Phải đủ 64 ký tự Hex = 32 bytes dùng cho AES-256-GCM)
# Sinh ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="<generate-64-character-hex-string>"

# Webhook Secret (Dùng cho Casso / SePay)
BANK_WEBHOOK_SECRET="<generate-webhook-secret-token>"

# Cấu hình API Webhook SePay / Casso (Tùy chọn)
SEPAY_API_KEY=""
CASSO_API_KEY=""

# Default User Setup (Dùng khi chạy seed / tài khoản quản trị ban đầu)
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="<choose-a-strong-password>"
